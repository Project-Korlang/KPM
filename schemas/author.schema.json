{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Korlang Author Profile",
  "type": "object",
  "required": [
    "handle",
    "name",
    "email_hash",
    "verified",
    "packages",
    "joined_at"
  ],
  "properties": {
    "handle": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 3,
      "maxLength": 30,
      "description": "Unique author handle (matches GitHub username usually)"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Display name"
    },
    "email_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$",
      "description": "MD5 hash of email (for Gravatar)"
    },
    "verified": {
      "type": "boolean",
      "description": "Whether the author identity is verified by registry maintainers"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of owned package names"
    },
    "joined_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of registration"
    },
    "public_key": {
        "type": "string",
        "description": "PGP or Ed25519 public key for package signing verification"
    },
    "github_url": {
        "type": "string",
        "format": "uri"
    },
    "twitter_url": {
        "type": "string",
        "format": "uri"
    },
    "website_url": {
        "type": "string",
        "format": "uri"
    }
  }
}
